######################################################################
# package_routines for the OpenList QPKG
#
# Install hooks are FUNCTIONS (pkg_init/pkg_install/pkg_post_install).
# Removal hooks are shell blocks inlined into the generated uninstall
# script at BUILD time — anything that must evaluate at removal time has
# to be escaped as \$VAR / \$(cmd).
######################################################################

# Run-time data directories. Created imperatively and deliberately NOT shipped
# in the package: QDK only tracks shipped files for obsolete-file cleanup on
# upgrade, so a directory it never saw is never touched by an upgrade.
# Uninstall does remove it, which is intended — OpenList recreates its
# database, config and logs on the next install (only the storage
# definitions and the admin account have to be added again).
pkg_install(){
    $CMD_MKDIR -p "$SYS_QPKG_DIR/data/log"
    $CMD_MKDIR -p "$SYS_QPKG_DIR/data/temp"
}

pkg_post_install(){
    # qbuild keeps the builder's uid. On the NAS that uid can belong to a real
    # user, who could then edit scripts QTS runs as root.
    $CMD_CHOWN -R 0:0 "$SYS_QPKG_DIR"
    $CMD_CHMOD 755 "$SYS_QPKG_DIR/openlist.sh"
    $CMD_CHMOD 755 "$SYS_QPKG_DIR/openlist"

    # Daily log-size cap for the stdout capture. OpenList rotates its own
    # data/log/log.log, but console.log is written by this package and
    # nobody else, so the rotation has to live here.
    CRONTAB=/etc/config/crontab
    if [ -f "$CRONTAB" ] && ! $CMD_GREP -qF "$SYS_QPKG_DIR/openlist.sh rotate" "$CRONTAB" 2>/dev/null; then
        echo "0 4 * * * /bin/sh $SYS_QPKG_DIR/openlist.sh rotate >/dev/null 2>&1" >> "$CRONTAB"
        crontab "$CRONTAB" 2>/dev/null
        /etc/init.d/crond.sh restart >/dev/null 2>&1
    fi
}

PKG_PRE_REMOVE="{
    \$SYS_QPKG_DIR/openlist.sh stop 2>/dev/null || true
    CRONTAB=/etc/config/crontab
    if \$CMD_GREP -qF 'openlist.sh rotate' \"\$CRONTAB\" 2>/dev/null; then
        \$CMD_SED -i '\\#openlist.sh rotate#d' \"\$CRONTAB\"
        crontab \"\$CRONTAB\" 2>/dev/null
        /etc/init.d/crond.sh restart >/dev/null 2>&1
    fi
}"
